client browser { label: "Browser" }
service api { label: "API" }
queue jobs { label: "Job queue" }
job worker { label: "Worker" }
database db { label: "Database" }
browser -> api: calls "request" { source_port: "right" target_port: "left" }
api -> jobs: publishes "enqueue"
jobs -> worker: flow "dispatch"
worker -> db: writes "persist"

view "Request" {
 include: [client "browser", service "api", queue "jobs", job "worker", database "db", edges: outgoing from "browser", edges: outgoing from "api", edges: outgoing from "jobs", edges: outgoing from "worker"]
 layout { direction: left-right }
}
